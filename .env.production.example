# CargoPilot frontend production env template.
# These values are build-time for Next.js because they use NEXT_PUBLIC_*.

# Bind to 127.0.0.1 when Nginx/Caddy terminates HTTPS on the same server.
FRONTEND_PORT=3000
FRONTEND_BIND=127.0.0.1
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_PAYMENTS_ENABLED=true
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SUPPORT_PHONE=+998 00 000 00 00

# Keep disabled in production unless intentionally testing map mocks.
NEXT_PUBLIC_LIVE_MAP_ALLOW_MOCK=false
